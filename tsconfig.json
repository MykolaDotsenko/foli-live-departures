{
  // The data layer is checked strictly: src/api reads Föli's untrusted JSON
  // into the shapes in src/types, and src/utils computes everything the
  // screen and Ride Mode rely on from them. JSDoc carries the types, so the
  // code still ships as plain JavaScript and nothing is compiled.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/api/*.js", "src/utils/*.js", "src/types/*.d.ts"],
  "exclude": ["src/**/*.test.js"]
}
