{
  "name": "foli-live-departures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "lint": "eslint --max-warnings 0 src e2e scripts playwright.config.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:bundle": "node --test scripts/css-module-names.test.mjs && node scripts/verify-bundle.mjs",
    "verify:csp": "node scripts/verify-csp.mjs",
    "verify:native-boundary": "node scripts/verify-native-provider-boundary.mjs",
    "verify:api-reference": "node scripts/verify-foli-api-reference.mjs",
    "verify:brand": "node scripts/verify-branding.mjs",
    "verify:deployment": "node scripts/verify-deploy-workflow.mjs && node --test scripts/verify-production-site.test.mjs",
    "verify:workflow-pins": "node scripts/verify-workflow-pins.mjs",
    "verify:architecture": "node scripts/verify-backendless.mjs",
    "verify:android-release": "node --test scripts/android-release-metadata.test.mjs && node scripts/verify-android-release.mjs",
    "verify:android-publish": "node scripts/verify-android-publish.mjs",
    "verify:place-search-policy": "node scripts/verify-place-search-policy.mjs",
    "verify:live-contract": "node scripts/verify-live-contract-workflow.mjs",
    "stamp:deployment": "node scripts/stamp-deployment.mjs",
    "verify:production-site": "node scripts/verify-production-site.mjs",
    "verify:release-provenance": "node --test scripts/release-provenance.test.mjs && node scripts/verify-release-provenance-workflows.mjs",
    "verify:android-e2e-log": "node --test scripts/verify-android-app-log.test.mjs",
    "predev": "node scripts/build-locale-packs.mjs",
    "prebuild": "node scripts/build-locale-packs.mjs",
    "configure:android-active-ride": "node scripts/configure-android-active-ride.mjs",
    "verify:android-active-ride": "node --test scripts/configure-android-active-ride.test.mjs",
    "verify:play-release": "node scripts/verify-play-release.mjs && node --test scripts/verify-android-play-target.test.mjs",
    "verify:android-play-target": "node scripts/verify-android-play-target.mjs",
    "build:play-store-assets": "node scripts/build-play-store-assets.mjs",
    "verify:play-assets": "node scripts/verify-play-assets.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
